---
import { getCollection, type CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { CATEGORIES } from "@/data/categories";
import { getSeriesPosts, getUnseriesedPosts } from "@/utils/getSeries";
import { getPostUrl } from "@/utils/getPostPaths";
import { resolveTimezone } from "@/utils/resolveTimezone";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");

const categories = CATEGORIES.map(category => {
  const series = category.series.map(s => ({
    ...s,
    posts: getSeriesPosts(posts, s.id),
  }));
  return {
    ...category,
    series,
    count: series.reduce((n, s) => n + s.posts.length, 0),
  };
});

// Posts outside every registered series, newest first.
const others = getUnseriesedPosts(posts).sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);

// Same calendar day the post's byline shows (see Datetime.astro).
const formatDate = (post: CollectionEntry<"posts">) =>
  dayjs(post.data.pubDatetime)
    .tz(resolveTimezone(post.data.timezone ?? config.site.timezone))
    .format("YYYY.MM.DD");
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    {
      categories.map(category => (
        <section id={category.id} class="mb-12 scroll-mt-8">
          <h2 class="text-2xl font-bold">
            {category.title}{" "}
            <sup class="text-muted-foreground text-sm font-normal">
              {category.count}
            </sup>
          </h2>
          <p class="text-muted-foreground mt-1">{category.description}</p>

          {category.series.map(series => (
            <div id={series.id} class="mt-8 scroll-mt-8">
              <h3 class="text-xl font-semibold">
                <a href={`#${series.id}`} class="hover:text-accent">
                  {series.title}
                </a>{" "}
                <sup class="text-muted-foreground text-sm font-normal">
                  {series.posts.length}
                </sup>
              </h3>
              <p class="mt-1">{series.description}</p>

              {series.posts.length > 0 ? (
                <ol class="mt-3 list-decimal space-y-3 ps-6">
                  {series.posts.map(post => (
                    <li>
                      <a
                        href={getPostUrl(post.id, post.filePath, locale)}
                        class="text-accent font-medium underline decoration-dashed underline-offset-4 hover:no-underline"
                        title={post.data.title}
                      >
                        {post.data.shortTitle ?? post.data.title}
                      </a>
                      <span class="text-muted-foreground ms-2 text-sm whitespace-nowrap">
                        {formatDate(post)}
                      </span>
                      <p class="text-muted-foreground mt-0.5 text-sm">
                        {post.data.description}
                      </p>
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="text-muted-foreground mt-3 text-sm">
                  {t.pages.categoriesEmpty}
                </p>
              )}
            </div>
          ))}
        </section>
      ))
    }

    {
      others.length > 0 && (
        <section id="others" class="scroll-mt-8">
          <h2 class="text-2xl font-bold">
            {t.pages.categoriesOthers}{" "}
            <sup class="text-muted-foreground text-sm font-normal">
              {others.length}
            </sup>
          </h2>
          <ul>
            {others.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </section>
      )
    }
  </Main>

  <Footer />
</Layout>
